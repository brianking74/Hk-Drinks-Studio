# Copy this file to .env (local dev) OR set these in Vercel's Environment Variables UI.
# Never commit your real .env file.

# Database (use Supabase, Neon, Railway, or any hosted PostgreSQL)
# Format: postgresql://user:password@host:port/dbname?schema=public
DATABASE_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres"

# Meta Graph API credentials — see DEPLOYMENT.md for how to get these
META_APP_ID="1399563551640566"
META_APP_SECRET="your-32-char-app-secret"
META_PAGE_ID="820518311147657"
META_IG_USER_ID="17841478187991967"
META_PAGE_ACCESS_TOKEN="EAAT...your-long-page-access-token"

# Public URL where this app is hosted (used by Meta to fetch uploaded images for IG)
# In local dev: http://localhost:3000
# In production: https://your-app.vercel.app or https://studio.yourdomain.com
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
